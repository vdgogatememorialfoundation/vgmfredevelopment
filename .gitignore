# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# mobile app
/mobile/node_modules
/mobile/package-lock.json
/mobile/.expo
/mobile/android/.gradle
/mobile/android/app/build
/mobile/android/build
/mobile/ios/Pods
/native/android-apps/.gradle
/native/android-apps/build
/native/android-apps/app/build
/native/android-apps/local.properties
/native/flutter/.dart_tool
/native/flutter/.flutter-plugins
/native/flutter/.flutter-plugins-dependencies
/native/flutter/build
/native/flutter/.idea
/native/flutter/android/.gradle
/native/flutter/android/local.properties
/native/flutter/android/app/src/main/java/io/flutter/plugins/
*.apk
*.aab
*.ipa
!public/apps/*.apk
