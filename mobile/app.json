{
  "expo": {
    "name": "Vaidya Gogate Memorial Foundation",
    "slug": "vgmf-foundation",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "scheme": "vgmf",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F4F0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.vaidyagogate.app",
      "infoPlist": {
        "CFBundleDisplayName": "Vaidya Gogate Memorial Foundation"
      }
    },
    "android": {
      "package": "org.vaidyagogate.app",
      "versionCode": 26,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#8F2D2D",
        "monochromeImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F6F4F0",
      "translucent": false
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFDF8"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "extra": {
      "apiUrl": "https://vaidyagogate.org",
      "flavor": "customer",
      "router": {
        "origin": false
      }
    }
  }
}
