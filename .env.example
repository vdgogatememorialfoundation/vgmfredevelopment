# Hosted copies on the Mumbai VPS. Do not use Vercel or Neon.
VGMF_ENV=staging
NEXT_PUBLIC_VGMF_ENV=staging
NEXT_PUBLIC_SITE_URL=https://staging.vaidyagogate.org
SITE_URL=https://staging.vaidyagogate.org

# Platform database (domain settings). App databases are set per flavour.
DATABASE_URL=postgresql://vgmf@127.0.0.1:5432/vgmf_staging_platform
VGMF_DB_CUSTOMER=postgresql://vgmf@127.0.0.1:5432/vgmf_staging_customer
VGMF_DB_ADMIN=postgresql://vgmf@127.0.0.1:5432/vgmf_staging_admin
VGMF_DB_STAFF=postgresql://vgmf@127.0.0.1:5432/vgmf_staging_staff
VGMF_DB_SUPPORT=postgresql://vgmf@127.0.0.1:5432/vgmf_staging_support

VGMF_DATA_DIR=/VGMF-PLATFORM/data/staging
HOSTNAME=127.0.0.1
PORT=3005

# Optional media storage. Leave empty until connected in Admin → Settings → Media storage.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGES_HASH=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=

# Optional sister-portal databases on the same VPS (never commit real passwords).
# Copy from the seminar / autism process env. Public APIs still sync events without these.
SEMINAR_DATABASE_URL=
AUTISM_DATABASE_URL=
